

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ====================================
// MODELS - STAGE 0
// ====================================

// User Model
model User {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  username      String?   @unique @db.VarChar(100)
  email         String?   @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  userRoles    UserRole[]
  userBranches UserBranch[]
  auditLogs    AuditLog[]
  sales        Sale[]
  cashSessions CashSession[]

  @@map("users")
}

// Role Model
model Role {
  id          Int    @id @default(autoincrement())
  name        String @unique @db.VarChar(100)
  description String? @db.Text

  // Relations
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

// Permission Model
model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique @db.VarChar(100)
  description String? @db.Text

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

// RolePermission - Pivot Table
model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// UserRole - Pivot Table
model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Branch Model
model Branch {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(255)
  code     String  @unique @db.VarChar(50)
  address  String? @db.Text
  phone    String? @db.VarChar(50)
  timezone String  @default("UTC") @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  // Relations
  userBranches   UserBranch[]
  warehouses     Warehouse[]
  sequences      Sequence[]
  settings       Setting[]
  auditLogs      AuditLog[]
  productPrices  ProductPrice[]
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]
  sales               Sale[]
  cashSessions        CashSession[]
  purchases           Purchase[]
  customerCreditEntries CustomerCreditEntry[]
  saleReturns         SaleReturn[]

  @@map("branches")
}

// UserBranch - Pivot Table
model UserBranch {
  userId    Int     @map("user_id")
  branchId  Int     @map("branch_id")
  isDefault Boolean @default(false) @map("is_default")

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

// Warehouse Model
model Warehouse {
  id       Int     @id @default(autoincrement())
  branchId Int     @map("branch_id")
  name     String  @db.VarChar(255)
  code     String  @unique @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  // Relations
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  locations      Location[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  purchases      Purchase[]

  @@map("warehouses")
}

// Location Model - Self-referential
model Location {
  id          Int     @id @default(autoincrement())
  warehouseId Int     @map("warehouse_id")
  name        String  @db.VarChar(255)
  code        String  @unique @db.VarChar(50)
  type        String  @db.VarChar(50) // e.g., 'zone', 'aisle', 'rack', 'bin'
  parentId    Int?    @map("parent_id")
  isActive    Boolean @default(true) @map("is_active")

  // Relations
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  parent    Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Location[] @relation("LocationHierarchy")

  @@map("locations")
}

// PaymentMethod Model
model PaymentMethod {
  id                Int     @id @default(autoincrement())
  name              String  @db.VarChar(100)
  type              String  @db.VarChar(50) // e.g., 'cash', 'card', 'transfer'
  requiresReference Boolean @default(false) @map("requires_reference")
  isActive          Boolean @default(true) @map("is_active")

  // Relations
  salePayments SalePayment[]

  @@map("payment_methods")
}

// Tax Model (Optional)
model Tax {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  rate       Decimal  @db.Decimal(5, 2) // e.g., 16.00 for 16%
  isIncluded Boolean  @default(false) @map("is_included")
  isActive   Boolean  @default(true) @map("is_active")

  // Relations
  products Product[]

  @@map("taxes")
}

// Sequence Model
model Sequence {
  id         Int    @id @default(autoincrement())
  branchId   Int    @map("branch_id")
  key        String @db.VarChar(50) // e.g., 'invoice', 'receipt', 'purchase_order'
  prefix     String @db.VarChar(20)
  nextNumber Int    @default(1) @map("next_number")
  padding    Int    @default(6) // Number of digits to pad

  // Relations
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([branchId, key])
  @@map("sequences")
}

// Setting Model
model Setting {
  id        Int     @id @default(autoincrement())
  scope     String  @db.VarChar(50) // 'global', 'branch'
  branchId  Int?    @map("branch_id")
  key       String  @db.VarChar(100)
  valueJson Json    @map("value_json") @db.JsonB

  // Relations
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([scope, branchId, key])
  @@map("settings")
}

// AuditLog Model
model AuditLog {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  userId      Int?     @map("user_id")
  branchId    Int?     @map("branch_id")
  action      String   @db.VarChar(50) // e.g., 'LOGIN', 'CREATE', 'UPDATE', 'DELETE', 'STATUS_CHANGE'
  entity      String   @db.VarChar(100) // e.g., 'User', 'Role', 'Branch'
  entityId    Int?     @map("entity_id")
  message     String   @db.Text
  ip          String?  @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  payloadJson Json?    @map("payload_json") @db.JsonB

  // Relations
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([branchId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ====================================
// MODELS - STAGE 1 · CATÁLOGO
// ====================================

// Category Model - Self-referential tree
model Category {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(150)
  parentId Int?    @map("parent_id")
  isActive Boolean @default(true) @map("is_active")

  // Relations
  parent     Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]  @relation("CategoryTree")
  products   Product[]
  promotions Promotion[]

  @@map("categories")
}

// Unit Model - units of measure (pieza, kg, litro…)
model Unit {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(50)
  abbreviation  String  @db.VarChar(10)
  allowsDecimal Boolean @default(false) @map("allows_decimal")

  // Relations
  products Product[]

  @@map("units")
}

// Product Model
model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique @db.VarChar(60)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  categoryId  Int?     @map("category_id")
  unitId      Int      @map("unit_id")
  taxId       Int?     @map("tax_id")
  sellType    String   @default("UNIT") @db.VarChar(20) // 'UNIT' | 'WEIGHT'
  trackStock  Boolean  @default(true) @map("track_stock")
  isActive    Boolean  @default(true) @map("is_active")
  imageUrl    String?  @map("image_url") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit           Unit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tax            Tax?             @relation(fields: [taxId], references: [id], onDelete: SetNull)
  barcodes       ProductBarcode[]
  prices         ProductPrice[]
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  saleReturnItems SaleReturnItem[]
  promotions      Promotion[]

  @@index([categoryId])
  @@map("products")
}

// ProductBarcode Model - a product can have several barcodes
model ProductBarcode {
  id           Int     @id @default(autoincrement())
  productId    Int     @map("product_id")
  code         String  @unique @db.VarChar(60)
  isPrimary    Boolean @default(false) @map("is_primary")
  packQuantity Decimal @default(1) @map("pack_quantity") @db.Decimal(12, 3) // box-of-N barcodes

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_barcodes")
}

// PriceList Model - "Público", "Mayoreo"…
model PriceList {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(100)
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  // Relations
  prices    ProductPrice[]
  customers Customer[]

  @@map("price_lists")
}

// ProductPrice Model - price per product + list, optionally per branch
model ProductPrice {
  id          Int     @id @default(autoincrement())
  productId   Int     @map("product_id")
  priceListId Int     @map("price_list_id")
  branchId    Int?    @map("branch_id") // null = applies to all branches
  cost        Decimal @default(0) @db.Decimal(12, 2)
  price       Decimal @db.Decimal(12, 2)

  // Relations
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, priceListId, branchId])
  @@index([priceListId])
  @@map("product_prices")
}

// ====================================
// MODELS - STAGE 1 · INVENTARIO
// ====================================

// StockLevel - denormalized cache of on-hand quantity per product + warehouse
model StockLevel {
  id           Int     @id @default(autoincrement())
  productId    Int     @map("product_id")
  branchId     Int     @map("branch_id")
  warehouseId  Int     @map("warehouse_id")
  quantity     Decimal @default(0) @db.Decimal(12, 3)
  reorderPoint Decimal @default(0) @map("reorder_point") @db.Decimal(12, 3)

  // Relations
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
  @@index([branchId])
  @@map("stock_levels")
}

// StockMovement - append-only inventory ledger; the source of truth for stock
model StockMovement {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  branchId     Int      @map("branch_id")
  warehouseId  Int      @map("warehouse_id")
  type         String   @db.VarChar(30) // SALE, PURCHASE, RETURN, ADJUSTMENT, TRANSFER_IN, TRANSFER_OUT, INITIAL
  quantity     Decimal  @db.Decimal(12, 3) // signed: negative = stock out
  balanceAfter Decimal  @map("balance_after") @db.Decimal(12, 3)
  unitCost     Decimal? @map("unit_cost") @db.Decimal(12, 2)
  refType      String?  @map("ref_type") @db.VarChar(30) // Sale, Purchase, Return…
  refId        Int?     @map("ref_id")
  note         String?  @db.Text
  userId       Int?     @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([productId, warehouseId])
  @@index([branchId, createdAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

// ====================================
// MODELS - STAGE 1 · CAJA Y VENTAS
// ====================================

// CashSession - "corte de caja"
model CashSession {
  id             Int       @id @default(autoincrement())
  branchId       Int       @map("branch_id")
  userId         Int       @map("user_id")
  folio          String    @db.VarChar(40)
  openingAmount  Decimal   @map("opening_amount") @db.Decimal(12, 2)
  closingAmount  Decimal?  @map("closing_amount") @db.Decimal(12, 2) // counted cash
  expectedAmount Decimal?  @map("expected_amount") @db.Decimal(12, 2) // computed
  difference     Decimal?  @db.Decimal(12, 2)
  status         String    @default("OPEN") @db.VarChar(20) // OPEN | CLOSED
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")

  // Relations
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  sales     Sale[]
  movements CashMovement[]

  @@index([branchId, status])
  @@map("cash_sessions")
}

// CashMovement - cash in/out not tied to a sale (retiros, gastos)
model CashMovement {
  id            Int      @id @default(autoincrement())
  cashSessionId Int      @map("cash_session_id")
  type          String   @db.VarChar(20) // IN | OUT
  amount        Decimal  @db.Decimal(12, 2)
  reason        String   @db.Text
  userId        Int      @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@map("cash_movements")
}

// Sale - a ticket / sales transaction
model Sale {
  id            Int       @id @default(autoincrement())
  clientUuid    String    @unique @map("client_uuid") @db.Uuid // idempotency key
  branchId      Int       @map("branch_id")
  warehouseId   Int?      @map("warehouse_id") // warehouse that supplies the sale
  cashSessionId Int?      @map("cash_session_id")
  customerId    Int?      @map("customer_id") // FK relation added in Stage · Clientes
  userId        Int       @map("user_id")
  folio         String?   @db.VarChar(40)
  status        String    @default("COMPLETED") @db.VarChar(20) // COMPLETED | CANCELLED | LAYAWAY
  type          String    @default("SALE") @db.VarChar(20) // SALE | LAYAWAY
  subtotal      Decimal   @db.Decimal(12, 2)
  discountTotal Decimal   @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal      Decimal   @default(0) @map("tax_total") @db.Decimal(12, 2)
  total         Decimal   @db.Decimal(12, 2)
  paidTotal     Decimal   @default(0) @map("paid_total") @db.Decimal(12, 2)
  changeGiven   Decimal   @default(0) @map("change_given") @db.Decimal(12, 2)
  isCredit      Boolean   @default(false) @map("is_credit")
  fiscalStatus  String    @default("NONE") @map("fiscal_status") @db.VarChar(20) // CFDI-ready
  uuidFiscal    String?   @map("uuid_fiscal") @db.VarChar(40)
  soldAt        DateTime  @map("sold_at")
  syncedAt      DateTime? @map("synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashSession CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items       SaleItem[]
  payments    SalePayment[]
  returns     SaleReturn[]

  @@index([branchId, soldAt])
  @@index([cashSessionId])
  @@index([customerId])
  @@map("sales")
}

// SaleItem - a line on a sale
model SaleItem {
  id          Int     @id @default(autoincrement())
  saleId      Int     @map("sale_id")
  productId   Int     @map("product_id")
  productName String  @map("product_name") @db.VarChar(255) // snapshot at sale time
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  promotionId Int?    @map("promotion_id")
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)

  // Relations
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_items")
}

// SalePayment - a payment applied to a sale
model SalePayment {
  id              Int     @id @default(autoincrement())
  saleId          Int     @map("sale_id")
  paymentMethodId Int     @map("payment_method_id")
  amount          Decimal @db.Decimal(12, 2)
  reference       String? @db.VarChar(100)

  // Relations
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_payments")
}

// ====================================
// MODELS - STAGE 1 · PROVEEDORES Y COMPRAS
// ====================================

// Supplier Model
model Supplier {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(255)
  rfc         String? @db.VarChar(13)
  contactName String? @map("contact_name") @db.VarChar(150)
  phone       String? @db.VarChar(50)
  email       String? @db.VarChar(255)
  isActive    Boolean @default(true) @map("is_active")

  // Relations
  purchases Purchase[]

  @@map("suppliers")
}

// Purchase Model - goods received from a supplier
model Purchase {
  id          Int       @id @default(autoincrement())
  branchId    Int       @map("branch_id")
  warehouseId Int       @map("warehouse_id")
  supplierId  Int       @map("supplier_id")
  folio       String    @db.VarChar(40)
  status      String    @default("DRAFT") @db.VarChar(20) // DRAFT | RECEIVED | CANCELLED
  invoiceRef  String?   @map("invoice_ref") @db.VarChar(60)
  subtotal    Decimal   @default(0) @db.Decimal(12, 2)
  taxTotal    Decimal   @default(0) @map("tax_total") @db.Decimal(12, 2)
  total       Decimal   @default(0) @db.Decimal(12, 2)
  receivedAt  DateTime? @map("received_at")
  userId      Int?      @map("user_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplier  Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items     PurchaseItem[]

  @@unique([branchId, folio])
  @@index([supplierId])
  @@map("purchases")
}

// PurchaseItem - a line on a purchase
model PurchaseItem {
  id         Int     @id @default(autoincrement())
  purchaseId Int     @map("purchase_id")
  productId  Int     @map("product_id")
  quantity   Decimal @db.Decimal(12, 3)
  unitCost   Decimal @map("unit_cost") @db.Decimal(12, 2)
  lineTotal  Decimal @map("line_total") @db.Decimal(12, 2)

  // Relations
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@map("purchase_items")
}

// ====================================
// MODELS - STAGE 1 · CLIENTES Y CRÉDITO
// ====================================

// Customer Model
model Customer {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  email         String?  @db.VarChar(255)
  rfc           String?  @db.VarChar(13)
  fiscalRegime  String?  @map("fiscal_regime") @db.VarChar(10) // CFDI-ready
  cfdiUse       String?  @map("cfdi_use") @db.VarChar(10) // CFDI-ready
  priceListId   Int?     @map("price_list_id")
  creditEnabled Boolean  @default(false) @map("credit_enabled")
  creditLimit   Decimal  @default(0) @map("credit_limit") @db.Decimal(12, 2)
  creditBalance Decimal  @default(0) @map("credit_balance") @db.Decimal(12, 2) // current debt
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  priceList     PriceList?            @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  sales         Sale[]
  creditEntries CustomerCreditEntry[]

  @@map("customers")
}

// CustomerCreditEntry - ledger of credit charges (fiado) and payments (abonos)
model CustomerCreditEntry {
  id              Int      @id @default(autoincrement())
  customerId      Int      @map("customer_id")
  branchId        Int      @map("branch_id")
  type            String   @db.VarChar(20) // CHARGE | PAYMENT
  amount          Decimal  @db.Decimal(12, 2) // signed: charge +, payment -
  balanceAfter    Decimal  @map("balance_after") @db.Decimal(12, 2)
  refType         String?  @map("ref_type") @db.VarChar(20) // Sale, Payment
  refId           Int?     @map("ref_id")
  paymentMethodId Int?     @map("payment_method_id")
  note            String?  @db.Text
  userId          Int?     @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("customer_credit_entries")
}

// ====================================
// MODELS - STAGE 1 · DEVOLUCIONES
// ====================================

// SaleReturn - a return / credit note against a sale
model SaleReturn {
  id           Int      @id @default(autoincrement())
  saleId       Int      @map("sale_id")
  branchId     Int      @map("branch_id")
  folio        String   @db.VarChar(40)
  reason       String   @db.Text
  total        Decimal  @db.Decimal(12, 2)
  refundMethod String   @map("refund_method") @db.VarChar(20) // CASH | CREDIT_NOTE | CREDIT_BALANCE
  userId       Int?     @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  sale   Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  branch Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items  SaleReturnItem[]

  @@index([saleId])
  @@map("sale_returns")
}

// SaleReturnItem - a returned line
model SaleReturnItem {
  id           Int     @id @default(autoincrement())
  saleReturnId Int     @map("sale_return_id")
  saleItemId   Int     @map("sale_item_id") // original sale line
  productId    Int     @map("product_id")
  quantity     Decimal @db.Decimal(12, 3)
  lineTotal    Decimal @map("line_total") @db.Decimal(12, 2)
  restock      Boolean @default(true)

  // Relations
  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleReturnId])
  @@index([saleItemId])
  @@map("sale_return_items")
}

// ====================================
// MODELS - STAGE 1 · PROMOCIONES
// ====================================

// Promotion - automatic discount applied at the POS
model Promotion {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(150)
  type       String    @db.VarChar(20) // PERCENT | FIXED | NXM
  value      Decimal   @default(0) @db.Decimal(12, 2) // percent (0-100) or fixed amount
  buyQty     Int?      @map("buy_qty") // NxM: buy N
  payQty     Int?      @map("pay_qty") // NxM: pay M
  scope      String    @default("PRODUCT") @db.VarChar(20) // PRODUCT | CATEGORY
  productId  Int?      @map("product_id")
  categoryId Int?      @map("category_id")
  startsAt   DateTime? @map("starts_at")
  endsAt     DateTime? @map("ends_at")
  isActive   Boolean   @default(true) @map("is_active")

  // Relations
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("promotions")
}
